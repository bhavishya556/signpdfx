{
  "name": "signpdfx",
  "version": "1.1.0",
  "description": "Extract X.509 certificates from PDF signatures",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "pdf",
    "certificate",
    "x509",
    "signature",
    "extract",
    "crypto",
    "typescript"
  ],
  "scripts": {
    "build": "tsc && cp lib/helpers/rootCAs.json dist/lib/helpers/",
    "prepublishOnly": "npm run build",
    "start": "node dist/lib/index.js",
    "jadu": "npm run build && npm run start",
    "example": "tsc && cp lib/helpers/rootCAs.json dist/lib/helpers/ && node dist/example.js",
    "example-json": "tsc && cp lib/helpers/rootCAs.json dist/lib/helpers/ && node example-json-usage.js",
    "dev": "tsc && cp lib/helpers/rootCAs.json dist/lib/helpers/ && node dist/lib/index.js",
    "clean": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Bhavishya Verma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhavishya556/signpdfxsignpdfx.git"
  },
  "bugs": {
    "url": "https://github.com/bhavishya556/signpdfx/issues"
  },
  "homepage": "https://github.com/bhavishya556/signpdfx#readme",
  "dependencies": {
    "node-forge": "^1.3.1",
    "base64-js": "^1.5.1",
    "ieee754": "^1.2.1"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}