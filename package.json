{
  "name": "signpdfx",
  "version": "1.1.1",
  "description": "Extract X.509 certificates from PDF signatures",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "require": "./dist/lib/index.js",
      "import": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "pdf",
    "certificate",
    "x509",
    "signature",
    "extract",
    "crypto",
    "typescript"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "prepublishOnly": "npm run build",
    "example": "npm run build && node dist/example.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test"
  },
  "author": "Bhavishya Verma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhavishya556/signpdfx.git"
  },
  "bugs": {
    "url": "https://github.com/bhavishya556/signpdfx/issues"
  },
  "homepage": "https://github.com/bhavishya556/signpdfx#readme",
  "dependencies": {
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.14"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
