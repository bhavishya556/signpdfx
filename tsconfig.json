{
    "compilerOptions": {
        "target": "es5",
        "module": "CommonJS",
        "moduleResolution": "node",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "isolatedModules": true
    },
    "include": [
        "lib/**/*",
        "example.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.js",
        "**/*.test.ts"
    ]
}